# --- Shared, same value on both dev and prod ---
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=your_database_name
POSTGRES_PORT=5432

BACKEND_PORT=8080
BACKEND_HOST_PORT=8080
BACKEND_HOST=127.0.0.1

FRONTEND_HOST_PORT=8090
VITE_API_URL=/api

# --- different values for dev and prod ---
# LLM used for vulnerability extraction.
#   LLM_PROVIDER  required. API standard: "anthropic" or "openai"
#                 (OpenAI or any compatible provider, e.g. TensorX)
#   LLM_API_KEY   required. Key of the selected provider.
#   LLM_MODEL     required. e.g. claude-haiku-4-5 (anthropic), z-ai/glm-5.3-flash (TensorX)
#   LLM_BASE_URL  required for openai, e.g. https://api.tensorx.ai/v1;
#                 optional for anthropic (defaults to the official API)
LLM_PROVIDER=anthropic
LLM_API_KEY=xxxxxxxxxxxxx
LLM_MODEL=claude-haiku-4-5
LLM_BASE_URL=
GITHUB_TOKEN=xxxxxxxxxxxxx
GRAFANA_PASSWORD=

# --- Prod only ---
GRAFANA_ROOT_URL=
SERVER_PUBLIC_IP=
# ADMINER_BEARER is NOT read from .env — the prod pipeline injects it directly
# into Caddyfile.template at deploy time; it never reaches the app containers.

# --- Dev only (isolated dev box, egress via the gateway proxy) ---
GATEWAY_HTTP_PROXY=
GATEWAY_HTTPS_PROXY=
SERVER_PRIVATE_IP=